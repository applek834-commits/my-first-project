# Copy this file to .env and fill in your key. .env is gitignored.
# Free key: https://console.groq.com/keys

# ---------------------------------------------------------------- Groq ----
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
# Verify the active list for YOUR key at https://console.groq.com/docs/models
# (or GET https://api.groq.com/openai/v1/models). Groq retires model IDs often.
# Common alternatives: openai/gpt-oss-120b, qwen/qwen3.8-27b, allam-2-7b.
# qwen/qwen3.8-27b free tier allows at most 1000 output tokens/min -> keep MAX_TOKENS<=1000.
TEMPERATURE=0.2
MAX_TOKENS=800

# ------------------------------------------------------- Corpus & chunks ---
# The notebook called this folder rag_course_docs; here it is ragg/
CORPUS_DIR=./ragg
CHUNK_SIZE=300
CHUNK_OVERLAP=50

# ------------------------------------------------------------- Embeddings ---
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_BATCH_SIZE=32
MAX_LENGTH=256

# --------------------------------------------------------------- Retrieval ---
DEFAULT_K=5
MAX_K=20
HYBRID_CANDIDATES=20
# Below this top semantic similarity the assistant abstains ("I do not know").
MIN_SCORE=0.4
ABSTAIN_GUARD=true

# ------------------------------------------------------------ Index cache ---
STORAGE_DIR=./backend/storage
INDEX_PATH=./backend/storage/rag.index
VECTORS_PATH=./backend/storage/rag_vectors.npy
META_PATH=./backend/storage/rag_meta.json

# ------------------------------------------------------------------ Server ---
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
