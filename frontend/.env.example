# Vite reads VITE_* variables at BUILD TIME (not at runtime).
# Leave this empty for local development: Vite proxies /api -> localhost:8000.
#
# For a deployed frontend, set this in the Vercel project's Environment
# Variables BEFORE building, pointing at your deployed FastAPI backend and
# including the /api suffix, for example:
#   VITE_API_BASE_URL=https://your-backend.example.com/api
#
# After changing it you must REDEPLOY, because the value is baked into the JS.
VITE_API_BASE_URL=
