# Vite reads VITE_* variables at BUILD TIME (not at runtime).
#
# Leave this EMPTY in both of the normal setups:
#   * local dev  -> Vite proxies /api to http://127.0.0.1:8000 (FastAPI)
#   * Vercel     -> /api is served same-origin by the Python functions in api/
#
# Only set it if you host the backend on a different origin, e.g. the Docker
# FastAPI service described in DEPLOYMENT.md. Value must include /api:
#   VITE_API_BASE_URL=https://your-backend.example.com/api
#
# After changing it you must REDEPLOY, because the value is baked into the JS.
VITE_API_BASE_URL=
